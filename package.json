{
    "name": "algo-rich",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "predev": "npx tsx scripts/validate-env.ts",
        "build": "prisma generate && prisma migrate deploy && next build",
        "prebuild": "npx tsx scripts/validate-env.ts",
        "start": "next start",
        "lint": "eslint",
        "test": "vitest run",
        "db:test": "node scripts/test-prisma-connection.js",
        "postinstall": "prisma generate",
        "seed": "prisma db seed",
        "seed:problems": "npx tsx prisma/seed-problems.ts",
        "seed:problems-v2": "npx tsx prisma/seed-problems.ts",
        "seed:ds": "node prisma/seed-ds.js",
        "seed:all": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-runner.ts",
        "seed-phases-3-5": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed-phases-3-5.ts",
        "seed:master": "npx tsx prisma/seed-master.ts",
        "prisma:migrate": "prisma migrate deploy",
        "prisma:dev": "prisma migrate dev",
        "prisma:generate": "prisma generate",
        "prisma:seed": "prisma db seed"
    },
    "dependencies": {
        "@monaco-editor/react": "^4.7.0",
        "@prisma/client": "^5.22.0",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-tabs": "^1.1.13",
        "@supabase/ssr": "^0.12.3",
        "@supabase/supabase-js": "^2.110.6",
        "bcryptjs": "^3.0.3",
        "canvas-confetti": "^1.9.4",
        "framer-motion": "^12.34.0",
        "gsap": "^3.14.2",
        "lucide-react": "^0.574.0",
        "next": "16.1.6",
        "next-auth": "^5.0.0-beta.30",
        "posthog-js": "^1.369.0",
        "prisma": "^5.22.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-markdown": "^10.1.0",
        "rehype-highlight": "^7.0.2",
        "rehype-raw": "^7.0.0",
        "remark-gfm": "^4.0.1",
        "resend": "^6.16.0",
        "stripe": "^22.0.1"
    },
    "prisma": {
        "seed": "npx tsx prisma/seed-master.ts"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/bcryptjs": "^2.4.6",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^20",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "dotenv": "^16.4.5",
        "eslint": "^8",
        "eslint-config-next": "14.2.3",
        "jsdom": "^29.0.2",
        "pg": "^8.22.0",
        "postcss": "^8",
        "tailwindcss": "^4.0.0-alpha.13",
        "ts-node": "^10.9.2",
        "tsx": "^4.16.2",
        "typescript": "^5",
        "vitest": "^4.1.4"
    }
}
