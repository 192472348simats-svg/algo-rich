# ========================================================================
# ALGO RICH - Environment Configuration Template
# ========================================================================
# Copy this file to .env.local and update with your local values.
# IMPORTANT: Never commit real passwords or credentials.
#
# There are TWO different database setups:
#   1. LOCAL DEVELOPMENT:  PostgreSQL on localhost (your laptop)
#   2. PRODUCTION (Vercel): Supabase Postgres (managed cloud)
#
# ========================================================================
# OPTION A: LOCAL DEVELOPMENT (PostgreSQL on localhost)
# ========================================================================
# Use this if developing on your laptop. Local PostgreSQL must be running.
#
# Setup:
#   1. Install PostgreSQL locally:
#      - macOS:   brew install postgresql@15
#      - Windows: Download from https://www.postgresql.org/download/windows/
#      - Linux:   sudo apt-get install postgresql postgresql-contrib
#      - Docker:  docker run --name algo-rich-postgres \
#                   -e POSTGRES_PASSWORD=dev_password \
#                   -e POSTGRES_USER=postgres \
#                   -e POSTGRES_DB=algo_rich \
#                   -p 5432:5432 -d postgres:17
#
#   2. Create database: createdb algo_rich
#   3. Update password below to your PostgreSQL password
#   4. Run migrations: npm run build (during first setup)
#   5. Test: npm run db:test
#
# For .env.local (LOCAL DEVELOPMENT):
DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/algo_rich?schema=public"
DIRECT_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/algo_rich?schema=public"

# ========================================================================
# OPTION B: PRODUCTION (Supabase on Vercel)
# ========================================================================
# NEVER put Supabase credentials in .env files!
# Instead, set these in Vercel dashboard → Settings → Environment Variables
#
# Get credentials from https://supabase.com:
#   1. Log in to your Supabase project → Settings → Database → Connection string
#   2. Select "Transaction pooler" (port 6543)
#      → Copy to Vercel as DATABASE_URL
#   3. Select "Session pooler" or "Direct connection" (port 5432)
#      → Copy to Vercel as DIRECT_URL
#
# Format examples (do NOT use these real values):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
#
# In Vercel:
#   - DATABASE_URL uses port 6543 (transaction pooler — for app queries)
#   - DIRECT_URL  uses port 5432 (direct/session — for migrations)
#

# ========================================================================
# AUTHENTICATION (NextAuth v5 / Auth.js)
# ========================================================================
# LOCAL DEVELOPMENT:
#   Use any random string (for dev only, doesn't need to match production)
#   To generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
AUTH_SECRET=dev-secret-32-chars-any-random-string
NEXTAUTH_URL=http://localhost:3000

# PRODUCTION (Vercel dashboard):
#   AUTH_SECRET = 32-character random string (generate with: openssl rand -base64 32)
#   AUTH_URL    = https://your-vercel-app.vercel.app
#
# IMPORTANT: If AUTH_SECRET changes between deployments:
#   - All existing user sessions become invalid
#   - Users will see "JWTSessionError" and must log in again
#   - This is EXPECTED and SECURE behavior
#

# ========================================================================
# PAYMENTS: Razorpay (for Indian students — UPI, Netbanking, Cards, Wallets)
# ========================================================================
# Sign up at https://dashboard.razorpay.com
# Use Test mode keys during development (no KYC required for testing)
#
# Get your keys from: Razorpay Dashboard → Settings → API Keys
#
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx
#
# Default payment amount in paise (₹499 = 49900 paise):
# RAZORPAY_DEFAULT_AMOUNT=49900
#
# To set up webhooks:
#   1. Go to Razorpay Dashboard → Settings → Webhooks
#   2. Add webhook URL: https://your-domain.com/api/webhooks/razorpay
#   3. Select events: payment.captured, subscription.activated,
#      subscription.charged, subscription.cancelled, subscription.expired
#   4. Copy the webhook secret to RAZORPAY_WEBHOOK_SECRET

# ========================================================================
# OPTIONAL: AI Chatbot (Groq — Zyra DSA Tutor)
# ========================================================================
# Sign up for free at https://console.groq.com
# Get your API key from: GroqCloud → API Keys
# Free tier: 30 requests/minute (perfect for a chatbot)
#
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========================================================================
# OPTIONAL: Debug Settings
# ========================================================================
# NODE_ENV=development
# DEBUG=prisma:*

# ========================================================================
# OPTIONAL: Password Reset Email (Resend)
# ========================================================================
# To send reset links by email instead of console fallback, configure:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="Algo Rich <no-reply@your-domain.com>"

# ========================================================================
# OPTIONAL: Analytics (PostHog)
# ========================================================================
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
