generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String            @id @default(uuid())
  name                  String
  email                 String            @unique
  password              String
  createdAt             DateTime          @default(now())
  experienceLevel       String?
  learningGoal          String?
  onboardingCompleted   Boolean           @default(false)
  dailyGoalMinutes      Int               @default(20)
  totalXP               Int               @default(0)
  firstLessonAt         DateTime?
  firstSolveAt          DateTime?
  firstVisualizerAt     DateTime?
  firstPlanAt           DateTime?
  currentPhase          Int               @default(1)
  currentWeek           Int               @default(1)
  phaseStartedAt        DateTime?
  phase1CompletedAt     DateTime?
  phase2CompletedAt     DateTime?
  phase3CompletedAt     DateTime?
  phase4CompletedAt     DateTime?
  streakFreezes         Int               @default(0)
  streakRepairAvailable Boolean           @default(false)
  streakRepairedAt      DateTime?
  targetInterviewDate   DateTime?
  lastBossCompletedAt   DateTime?
  bossProblemsWon       Int               @default(0)
  emailVerified         Boolean           @default(true)
  verificationToken     String?
  verificationExpiry    DateTime?

  progress        Progress[]
  submissions     Submission[]
  preferences     UserPreferences?
  patternProgress PatternProgress[]
  flashCards      FlashCard[]
  quizResults     QuizResult[]
  cardReviews     CardReview[]
  feedbacks       Feedback[]
  sessionProgress SessionProgress[]
  problemReviews  ProblemReview[]
  reflections     Reflection[]
}

model Problem {
  id                     String          @id @default(uuid())
  slug                   String          @unique
  title                  String
  difficulty             String
  pattern                String?
  topics                 String?
  companies              String?
  companyTags            String?
  company                String[]        @default([])
  description            String
  examples               String?
  constraints            String?
  hints                  String?
  starterCode            String
  solutionCode           String?
  solutionExplanation    String?
  timeComplexity         String?
  spaceComplexity        String?
  testCases              String
  hiddenTestCases        String?
  order                  Int             @default(0)
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  topicOrder             Int             @default(0)
  category               String?         @default("DSA")
  solutionApproach       String?
  visualizationType      String?
  phase                  Int             @default(3)
  weekNumber             Int             @default(1)
  prerequisiteProblems   String?
  conceptTaught          String?
  correctPattern         String?
  correctTimeComplexity  String?
  correctSpaceComplexity String?
  isOptimal              Boolean         @default(true)

  submissions  Submission[]
  patternModel Pattern?        @relation(fields: [pattern], references: [slug])
  lessons      LessonProblem[]
  reviews      ProblemReview[]
  reflections  Reflection[]
}

model Submission {
  id            String   @id @default(uuid())
  userId        String
  problemId     String
  code          String
  language      String   @default("python")
  status        String
  passedTests   Int      @default(0)
  totalTests    Int      @default(0)
  executionTime Int?
  errorMessage  String?
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([problemId])
}

model Course {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  category    String
  difficulty  String   @default("beginner")
  icon        String   @default("ðŸ“˜")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons Lesson[]
}

model Lesson {
  id            String   @id @default(uuid())
  slug          String   @unique
  courseId      String
  title         String
  content       String
  codeExample   String?
  order         Int
  difficulty    String
  estimatedTime Int

  course   Course          @relation(fields: [courseId], references: [id])
  progress Progress[]
  problems LessonProblem[]
}

model Progress {
  id           String    @id @default(uuid())
  userId       String
  lessonId     String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  masteryLevel String    @default("none")
  practicedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id])
  lesson Lesson @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model LessonProblem {
  id        String  @id @default(uuid())
  lessonId  String
  problemId String
  order     Int     @default(0)

  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([lessonId, problemId])
  @@index([lessonId])
  @@index([problemId])
}

model Pattern {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  description     String
  whenToUse       String
  template        String
  timeComplexity  String
  spaceComplexity String
  difficulty      Int
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  problems Problem[]
  progress PatternProgress[]
}

model PatternProgress {
  id                   String   @id @default(uuid())
  userId               String
  patternSlug          String
  status               String   @default("locked")
  visualizationWatched Boolean  @default(false)
  memoryVisualWatched  Boolean  @default(false)
  templateStudied      Boolean  @default(false)
  quizPassed           Boolean  @default(false)
  recognitionAccuracy  Float    @default(0)
  problemsSolved       Int      @default(0)
  averageTime          Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern Pattern @relation(fields: [patternSlug], references: [slug])

  @@unique([userId, patternSlug])
}

model FlashCard {
  id          String   @id @default(uuid())
  userId      String
  type        String
  front       String
  back        String
  code        String?
  patternId   String?
  ease        Float    @default(2.5)
  interval    Int      @default(1)
  repetitions Int      @default(0)
  nextReview  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuizResult {
  id         String   @id @default(uuid())
  userId     String
  quizType   String
  topic      String
  question   String   @default("book")
  userAnswer String   @default("book")
  correct    Boolean
  timeSpent  Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  id              String   @id @default(uuid())
  userId          String   @unique
  experienceLevel String
  learningGoal    String
  dailyGoalMins   Int      @default(30)
  onboardingDone  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(uuid())
  userId    String?
  type      String
  message   String
  page      String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model PredictionCard {
  id            String   @id @default(uuid())
  challengeId   String?  @unique
  type          String
  topic         String?
  difficulty    String
  treeValues    String?
  question      String
  visualData    String?
  options       String?
  correctAnswer String
  explanation   String
  xpReward      Int      @default(10)
  createdAt     DateTime @default(now())

  reviews CardReview[]
}

model CardReview {
  id             String         @id @default(uuid())
  userId         String
  cardId         String
  correct        Boolean
  responseTimeMs Int?
  easeFactor     Float          @default(2.5)
  interval       Int            @default(1)
  repetitions    Int            @default(0)
  nextReviewAt   DateTime       @default(now())
  createdAt      DateTime       @default(now())

  user User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  card PredictionCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model SessionProgress {
  id                String   @id @default(uuid())
  userId            String
  sessionSlug       String
  currentStageIndex Int      @default(0)
  completed         Boolean  @default(false)
  stageResults      String   @default("{}")
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  totalXPEarned     Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionSlug])
  @@index([userId, completed])
}

model ProblemReview {
  id             String   @id @default(uuid())
  userId         String
  problemId      String
  easeFactor     Float    @default(2.5)
  interval       Int      @default(1)
  repetitions    Int      @default(0)
  nextReviewAt   DateTime @default(now())
  lastRating     Int?
  totalReviews   Int      @default(0)
  lastReviewedAt DateTime?
  enrolledAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, nextReviewAt])
}

model Reflection {
  id                  String   @id @default(uuid())
  userId              String
  problemId           String
  submissionId        String?
  patternUsed         String?
  timeComplexity      String?
  spaceComplexity     String?
  canOptimize         String?
  approachExplanation String?
  patternCorrect      Boolean?
  timeCorrect         Boolean?
  spaceCorrect        Boolean?
  optimizeCorrect     Boolean?
  solveTimeSeconds    Int?
  skipped             Boolean  @default(false)
  createdAt           DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, problemId])
}
